{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
        "includeFiles": "{dist/server.cjs,assets/fonts/NotoSansHebrew-Regular.ttf,public/logo-no-text.jpeg,node_modules/pdfkit/js/standard-fonts/**}"
    }
  },
  "crons": [
    { "path": "/api/internal/daily-backup", "schedule": "0 21 * * *" },
    { "path": "/api/internal/daily-backup", "schedule": "0 22 * * *" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
